pkgname=lode
pkgver=0.1.0
pkgrel=1
pkgdesc='A Minecraft launcher with Modrinth and CurseForge built in'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libarchive')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lode "$pkgdir/usr/bin/lode"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lode.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lode.svg"
  install -Dm644 "$startdir/lode.desktop" "$pkgdir/usr/share/applications/lode.desktop"
}
